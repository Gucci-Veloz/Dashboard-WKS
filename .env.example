# Copia este archivo como .env en el servidor y llénalo ahí.
# .env nunca se guarda en el historial ni se comparte.

# Contraseña con la que Vania (Hermes) se identifica ante la API.
WORKS_TOKEN_VANIA=

# Opcional: los teléfonos se registran mejor con el comando "crear cuenta"
# de docs/despliegue-docker.md. Usa estas dos solo si no usas ese comando.
WORKS_WHATSAPP_DAVID=
WORKS_WHATSAPP_GRECIA=
